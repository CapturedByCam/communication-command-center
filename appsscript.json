{
  "timeZone": "America/New_York",
  "dependencies": {
    "enabledAdvancedServices": [
      {
        "userSymbol": "Sheets",
        "version": "v4",
        "serviceId": "sheets"
      },
      {
        "userSymbol": "Gmail",
        "version": "v1",
        "serviceId": "gmail"
      }
    ]
  },
  "exceptionLogging": "NONE",
  "runtimeVersion": "V8",
  "oauthScopes": [
    "https://www.googleapis.com/auth/spreadsheets",
    "https://www.googleapis.com/auth/gmail.readonly",
    "https://www.googleapis.com/auth/userinfo.email",
    "https://www.googleapis.com/auth/script.scriptapp"
  ],
  "webapp": {
    "access": "ANYONE_ANONYMOUS",
    "executeAs": "USER_DEPLOYING"
  },
  "addOns": {
    "common": {
      "name": "Communication Command Center",
      "logoUrl": "https://www.gstatic.com/images/icons/material/system/1x/assignment_black_48dp.png"
    },
    "studio": {
      "flows": {
        "workflowElements": [
          {
            "id": "cccValidateGmail",
            "state": "ACTIVE",
            "name": "Validate Gmail interpretation",
            "description": "Validate bounded interpretation against authoritative Gmail metadata and stage it privately. No drafts or sending.",
            "workflowAction": {
              "inputs": [
                {
                  "id": "gmail_message_id",
                  "description": "Gmail message ID from the starter",
                  "cardinality": "SINGLE",
                  "dataType": {
                    "basicType": "STRING"
                  }
                },
                {
                  "id": "model_json",
                  "description": "Bounded interpretation JSON",
                  "cardinality": "SINGLE",
                  "dataType": {
                    "basicType": "STRING"
                  }
                }
              ],
              "outputs": [
                {
                  "id": "status",
                  "description": "Validation status",
                  "cardinality": "SINGLE",
                  "dataType": {
                    "basicType": "STRING"
                  }
                },
                {
                  "id": "ingest_id",
                  "description": "Accepted intake ID, or empty",
                  "cardinality": "SINGLE",
                  "dataType": {
                    "basicType": "STRING"
                  }
                }
              ],
              "onConfigFunction": "cccConfigureStudioStep",
              "onExecuteFunction": "cccExecuteStudioStep"
            }
          }
        ]
      }
    }
  }
}
