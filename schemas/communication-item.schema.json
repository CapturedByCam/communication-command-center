{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capturedbycam.local/schemas/communication-item.schema.json",
  "title": "CommunicationItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "item_id",
    "source",
    "source_record_id",
    "source_thread_id",
    "captured_at",
    "updated_at",
    "category",
    "status",
    "waiting_on",
    "urgency",
    "priority_score",
    "next_action_type",
    "next_action",
    "summary",
    "draft_status",
    "confidence",
    "classifier_version",
    "content_hash",
    "raw_content_stored"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "item_id": {
      "type": "string",
      "pattern": "^cc_[A-Za-z0-9_-]{12,}$"
    },
    "source": {
      "enum": [
        "gmail",
        "apple_share_sheet",
        "manual",
        "chatgpt",
        "google_chat"
      ]
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_thread_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_link": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email"
        },
        "phone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "handle": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "category": {
      "enum": [
        "client_lead",
        "active_project",
        "aviation",
        "business_admin",
        "personal",
        "other"
      ]
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "status": {
      "enum": [
        "open",
        "snoozed",
        "resolved",
        "archived"
      ]
    },
    "waiting_on": {
      "enum": [
        "me",
        "them",
        "none",
        "unknown"
      ]
    },
    "urgency": {
      "enum": [
        "critical",
        "today",
        "this_week",
        "later"
      ]
    },
    "priority_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "next_action_type": {
      "enum": [
        "reply",
        "send_file",
        "schedule",
        "call",
        "follow_up",
        "review",
        "none"
      ]
    },
    "next_action": {
      "type": "string",
      "maxLength": 500
    },
    "summary": {
      "type": "string",
      "maxLength": 500
    },
    "preview": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 240
    },
    "deadline_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "deadline_text": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "needs_date_review": {
      "type": "boolean"
    },
    "follow_up_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "promised_follow_up": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "draft_status": {
      "enum": [
        "not_needed",
        "needed",
        "generated",
        "reviewed",
        "sent",
        "stale",
        "failed"
      ]
    },
    "gmail_draft_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "classifier_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manual_override": {
      "type": "boolean"
    },
    "snooze_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "resolved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "raw_content_stored": {
      "const": false
    },
    "last_error_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    }
  }
}